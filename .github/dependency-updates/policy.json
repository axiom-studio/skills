{
  "schemaVersion": 1,
  "repository": "axiom-studio/skills",
  "defaultBranch": "main",
  "candidatePrefix": "dependency-updates/",
  "allowedPaths": [
    "go.mod",
    "go.sum",
    "vendor/**",
    "tests/platform/go.mod",
    "tests/platform/go.sum",
    "skills/_lib/live-browser/package.json",
    "skills/_lib/live-browser/package-lock.json",
    "skills/live-browser/package.json",
    "skills/live-browser/package-lock.json",
    "skills/lightpanda/requirements.txt",
    "skills/lightpanda/pyproject.toml",
    "Dockerfile",
    "skills/lightpanda/Dockerfile",
    "skills/google-workspace/Dockerfile",
    "skills/mcp/Dockerfile",
    "skills/live-browser/Dockerfile"
  ],
  "goModule": "go.mod",
  "canonicalVendorRequired": true,
  "checks": [
    {
      "name": "Validate exact candidate",
      "script": ".github/dependency-updates/checks.sh"
    }
  ],
  "releaseWorkflow": null,
  "releaseMode": "manual",
  "renovateImage": "ghcr.io/renovatebot/renovate:44.132.2-full",
  "candidateRetentionLimit": 32
}
